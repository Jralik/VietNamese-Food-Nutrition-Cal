# .streamlit/secrets.toml.example
# Copy file này thành .streamlit/secrets.toml và điền các API key tương ứng.

# ─── Qdrant Cloud ───────────────────────────────────────────────────────────
# Lấy từ: https://cloud.qdrant.io → Cluster → Dashboard → API Keys
QDRANT_URL = "https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333"
QDRANT_API_KEY = "your-qdrant-api-key-here"

# ─── Gemini (Optional server-side key for building the KB) ──────────────────
# Nếu không điền, hệ thống sẽ dùng key người dùng nhập ở sidebar
# GEMINI_API_KEY = "AIza..."
